# Groq API Key (free tier)
# Get from https://console.groq.com/
GROQ_API_KEY=gsk_your_key_here

# Database URL
# SQLite (local): sqlite:///./stock_dd.db
# PostgreSQL (prod): postgresql://postgres:password@db.project.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./stock_dd.db

# Admin key for agent provisioning / API key management
ADMIN_KEY=your_admin_key_here

# Optional relay defaults for a Discord -> TickerClaw agent worker
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_discord_channel_id
DISCORD_ALLOWED_AUTHOR_IDS=comma,separated,author_ids
TICKERCLAW_API_KEY=your_agent_api_key
TICKERCLAW_API_BASE_URL=https://api.tickerclaw.com
DISCORD_POLL_INTERVAL_SECONDS=15
DISCORD_RELAY_STATE_FILE=.discord_agent_relay_state.json
